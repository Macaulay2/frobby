#!/usr/bin/env sh

frobby=$FROBBY
testhelper=../testScripts/testhelper
test="$1"
shift

if [ -e "$test.alexdual_point" ];
then
  input="$test.test $test.alexdual_point";
else
  input="$test.test"
fi

if [ "$1" = "_full" ];
then
  shift;

  # Check -canon agrees with transform.
  $testhelper transform $test.alexdual $test.alexdual -canon
  if [ $? != 0 ]; then exit 1; fi

  # Check that double dual on the same point is identity.
  $frobby transform < `ls $test.*test` > $FROBBY_TEST_TMPDIR/$test.test \
    -canon -minimize 2>/dev/null
  if [ -e "$test.alexdual_point" ];
  then
    pointFile="$test.alexdual_point";
  else
    $frobby analyze < $FROBBY_TEST_TMPDIR/$test.test 2>/dev/null > $FROBBY_TEST_TMPDIR/alexdual_point \
      -lcm -summaryLevel 0
    pointFile="$FROBBY_TEST_TMPDIR/alexdual_point";
  fi

  $testhelper alexdual "$test.alexdual $pointFile" $FROBBY_TEST_TMPDIR/$test.test $* -canon
  if [ $? != 0 ]; then exit 1; fi

  rm -f $FROBBY_TEST_TMPDIR/$test.test $FROBBY_TEST_TMPDIR/alexdual_point
fi

$testhelper alexdual "$input" $test.alexdual $* -canon
