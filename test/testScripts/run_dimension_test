#!/bin/bash

testHelper=../testScripts/testhelper
frobby=$FROBBY
test="$1"
shift
inputFile="$test.test"

if [ "$1" = "_full" ]; then
  shift;

  $testHelper dimension $test.test $test.dim $* -useSlice
  if [ $? != 0 ]; then exit 1; fi

  $frobby transform < $test.test -radical -minimize > $FROBBY_TEST_TMPDIR/frobbyTestTmp 2> /dev/null

  $testHelper dimension $FROBBY_TEST_TMPDIR/frobbyTestTmp $test.dim $* -squareFreeAndMinimal
  if [ $? != 0 ]; then rm $FROBBY_TEST_TMPDIR/frobbyTestTmp; exit 1; fi

  $testHelper dimension $FROBBY_TEST_TMPDIR/frobbyTestTmp $test.dim $* -useSlice -squareFreeAndMinimal
  if [ $? != 0 ]; then rm $FROBBY_TEST_TMPDIR/frobbyTestTmp; exit 1; fi

  rm $FROBBY_TEST_TMPDIR/frobbyTestTmp;
fi

$testHelper dimension $test.test $test.dim $*
if [ $? != 0 ]; then exit 1; fi
